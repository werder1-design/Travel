{
  "name": "display-iq-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Display IQ – Instagram-Reel (9:16, 1080x1920, 30fps) mit Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "node scripts/generate-audio.mjs",
    "render": "remotion render src/index.ts DisplayIQ out/display-iq-reel.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --image-format=png",
    "still": "remotion still src/index.ts DisplayIQ"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
